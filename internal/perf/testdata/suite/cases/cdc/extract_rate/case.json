{
  "id": "cdc.extract_rate", "version": 1, "owner": "hgryoo", "grade": "B", "module": "cdc",
  "topology": "single",
  "conf": { "supplemental_log": 2, "cdc_flag": true },
  "fixture": { "name": "narrow_1m", "version": 1 },
  "driver": "cdc-api",
  "clients": 1,
  "client": { "bin": "cdc_extract", "args": ["--items", "100000"] },
  "op": "item", "metric": "ops_per_s",
  "cold": false, "warm_s": 0, "warmup": 1, "repeats": 3, "budget_s": 180, "tolerance": 0.05,
  "counters": ["Num_log_append_records", "net_packets", "DWB_flush_block"],
  "background": "keep"
}
