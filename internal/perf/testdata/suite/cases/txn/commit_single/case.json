{
  "id": "txn.commit_single", "version": 1, "owner": "hgryoo", "grade": "A", "module": "txn",
  "topology": "single",
  "conf": { "data_buffer_size": "4G", "log_buffer_size": "16M" },
  "fixture": { "name": "narrow_1m", "version": 1 },
  "driver": "jdbc",
  "clients": 1,
  "client": { "main": "CommitSingle", "args": ["--rows", "20000"] },
  "op": "commit", "metric": "latency_s",
  "cold": false, "warm_s": 10, "warmup": 1, "repeats": 5, "budget_s": 120, "tolerance": 0.05,
  "counters": ["Num_log_page_iowrites", "Num_file_iosynches", "dev_flushes", "cas.rw_syscalls"],
  "judge_counters": ["Num_log_page_iowrites", "Num_file_iosynches", "dev_flushes"],
  "background": "defer"
}
