--- bug_xdbms265.sh
+++ bug_xdbms265.sh
@@ -15,7 +15,11 @@
 
 rm -rf aaa*
 
-cubrid_createdb -r aaa
+# testkit compatibility: this case took the volume size from cubrid.conf,
+# so its verdict depended on a setting it never named. CUBRID ships 512M and
+# the answers were written under it; a run that lowers it globally fails the
+# case. Say the size the case actually needs.
+cubrid_createdb --db-volume-size=512M -r aaa
 
 if [ $OS = "Windows_NT" ];then
 echo "0 $db_path\\aaa $db_path\\bbb" > rename.txt
