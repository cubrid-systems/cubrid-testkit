--- bug_xdbms913.sh
+++ bug_xdbms913.sh
@@ -529,6 +529,20 @@
 #check_inserting 
 
 backuptime_lv3=`date +%d-%m-%Y:%T`
+# testkit compatibility: backuptime_lv3 is a recovery boundary taken with
+# `date +%T`, which has one-second resolution, and the insert that must fall
+# *after* it takes less than a second on a fast machine. restoredb
+# --up-to-date is then inclusive of that same second and restores the rows the
+# boundary was meant to exclude.
+#
+# Measured: check_data_count wanted 10000 and got 20000 -- exactly the one
+# batch of 10000 that insert_data had just written.
+#
+# The case already knows this. Every other timestamp it takes -- lv0, lv1, lv2,
+# three times each -- is followed by `sleep 3` for this reason. Only lv3 is not,
+# and only where lv3 is followed by a write does it matter. This adds the same
+# sleep the case uses everywhere else, and changes nothing about what it tests.
+sleep 3
 
 insert_data 50001 60000 pdb
 
