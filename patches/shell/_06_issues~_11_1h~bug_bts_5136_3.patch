--- bug_bts_5136_3.sh
+++ bug_bts_5136_3.sh
@@ -22,7 +22,11 @@
 cubrid deletedb $db
 mkdir $db
 cd $db
-cubrid_createdb -r $db
+# testkit compatibility: this case took the volume size from cubrid.conf,
+# so its verdict depended on a setting it never named. CUBRID ships 512M and
+# the answers were written under it; a run that lowers it globally fails the
+# case. Say the size the case actually needs.
+cubrid_createdb --db-volume-size=512M -r $db
 cubrid spacedb -S $db > spacedb1.log
 cnt2=`cat spacedb1.log | grep '512.0 M' | wc -l`
 cnt3=`cat spacedb1.log | grep -E "(pagesize 16.0K|log pagesize: 16.0K)"| wc -l`
