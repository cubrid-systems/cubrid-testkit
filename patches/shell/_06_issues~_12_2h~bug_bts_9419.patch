--- bug_bts_9419.sh
+++ bug_bts_9419.sh
@@ -1,6 +1,15 @@
 #!/bin/sh
 . $init_path/init.sh
 init test
+
+# testkit compatibility: the case runs `cubrid_createdb -r 9419` with no size
+# for one of its three creations, so that one takes db_volume_size and
+# log_volume_size from cubrid.conf. Every .answer records what CUBRID ships:
+# "512.0M size ... needed is 1.5G". This run lowers both, and all thirteen
+# locales then print "64.0M ... 104.0M" and fail on a number the case never
+# names. Deleting the two lines gives the default the answers were written
+# under. cubrid.conf is restored before every case.
+sed -i '/^[[:space:]]*db_volume_size[[:space:]]*=/d;/^[[:space:]]*log_volume_size[[:space:]]*=/d' $CUBRID/conf/cubrid.conf
 cp $CUBRID/conf/cubrid_locales.all.txt $CUBRID/conf/cubrid_locales.txt 
 
 MODE=64
