--- _03_eventlog_tempvolume.sh
+++ _03_eventlog_tempvolume.sh
@@ -20,6 +20,15 @@
 
 mkdir $db
 cd $db
+# testkit compatibility: the case pins --db-volume-size on createdb, which
+# sizes the permanent volume only. The temporary volumes this test is about
+# take their size from cubrid.conf, which the case never names, and it then
+# counts DISK_ADD_VOLUME / DISK_EXTEND / TEMPORARY_VOLUME events exactly
+# (4, 6 and 10). This run lowers db_volume_size so 24 slots fit in memory, so
+# the temp volumes come out smaller and extend more often than the answer
+# records. Restoring what CUBRID ships puts the count back where it was
+# measured. cubrid.conf is restored before every case.
+sed -i 's/^[[:space:]]*db_volume_size[[:space:]]*=.*/db_volume_size=512M/' $CUBRID/conf/cubrid.conf
 cubrid_createdb $db --db-volume-size=20M -r
 cd ..
 
